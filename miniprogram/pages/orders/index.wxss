.orders-page {
  min-height: 100vh;
  padding: 26rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.orders-heading {
  position: relative;
  padding: 14rpx 4rpx 30rpx;
}

.orders-title {
  margin-top: 10rpx;
  color: #2e2923;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 700;
}

.orders-count {
  position: absolute;
  right: 4rpx;
  bottom: 36rpx;
  color: #9b8777;
  font-size: 21rpx;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-item {
  width: 100%;
  padding: 26rpx;
  color: #3d332b;
  text-align: left;
  background: #fffaf3;
  border: 2rpx solid #eee1d4;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(91, 65, 43, 0.04);
  transition: transform 120ms ease;
}

.order-item-hover {
  opacity: 0.8;
  transform: scale(0.99);
}

.order-item-top,
.order-details,
.order-item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-number {
  color: #8e7a69;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.order-state {
  padding: 8rpx 14rpx;
  color: #64704d;
  font-size: 19rpx;
  font-weight: 650;
  background: #eef0e5;
  border-radius: 14rpx;
}

.order-summary {
  margin-top: 20rpx;
  overflow: hidden;
  color: #332c26;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-details {
  margin-top: 12rpx;
  color: #9a8777;
  font-size: 20rpx;
}

.order-item-bottom {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #efe5da;
}

.order-total {
  color: #c24d2c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.order-currency {
  margin-right: 3rpx;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 19rpx;
}

.order-arrow {
  color: #9f5b40;
  font-size: 21rpx;
  font-weight: 600;
}

.orders-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 36rpx;
  text-align: center;
}

.empty-plate {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  font-size: 68rpx;
  background: #ede6db;
  border-radius: 50%;
}

.empty-title {
  margin-top: 28rpx;
  color: #45392f;
  font-size: 32rpx;
  font-weight: 650;
}

.empty-copy {
  margin-top: 10rpx;
  color: #968272;
  font-size: 22rpx;
}

.empty-button {
  width: 260rpx;
  margin-top: 30rpx;
}
