<view class="orders-page">
  <view class="orders-heading">
    <view class="section-label">ORDER HISTORY</view>
    <view class="orders-title">最近点过的好味道</view>
    <view class="orders-count">{{orders.length}} 笔订单</view>
  </view>

  <view wx:if="{{orders.length}}" class="orders-list">
    <button
      wx:for="{{orders}}"
      wx:key="id"
      class="order-item"
      hover-class="order-item-hover"
      data-id="{{item.id}}"
      bindtap="openOrder"
    >
      <view class="order-item-top">
        <view class="order-number">{{item.id}}</view>
        <view class="order-state">{{item.status}}</view>
      </view>
      <view class="order-summary">{{item.summary}}{{item.lines.length > 2 ? ' 等' : ''}}</view>
      <view class="order-details">
        <text>桌号 {{item.tableNo}} · {{item.orderType}}</text>
        <text>{{item.createdAtText}}</text>
      </view>
      <view class="order-item-bottom">
        <text class="order-total"><text class="order-currency">¥</text>{{item.subtotalText}}</text>
        <text class="order-arrow">查看详情 ›</text>
      </view>
    </button>
  </view>

  <view wx:else class="orders-empty">
    <view class="empty-plate">🍽</view>
    <view class="empty-title">还没有历史订单</view>
    <view class="empty-copy">完成第一笔点餐后，订单会保存在这里。</view>
    <button class="primary-button empty-button" bindtap="goHome">去点餐</button>
  </view>
</view>

