<view class="menu-page">
  <view class="store-header">
    <view class="store-topline">
      <view class="store-status">
        <view class="status-dot"></view>
        <text>门店营业中</text>
      </view>
      <view class="table-pill">桌号 {{tableNo}}</view>
    </view>
    <view class="store-name">灶边小馆</view>
    <view class="store-meta">今日食材新鲜到店 · 预计 20 分钟上齐</view>
  </view>

  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-row">
      <button
        wx:for="{{categories}}"
        wx:key="id"
        class="category-tab {{activeCategory === item.id ? 'category-tab-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >
        {{item.name}}
      </button>
    </view>
  </scroll-view>

  <view class="menu-content">
    <block wx:for="{{categories}}" wx:key="id">
      <view wx:if="{{activeCategory === item.id}}" class="category-section">
        <view class="section-heading">
          <view>
            <view class="section-label">{{item.eyebrow}}</view>
            <view class="category-title">{{item.name}}</view>
          </view>
          <view class="item-count">{{item.items.length}} 道</view>
        </view>
        <view class="category-description">{{item.description}}</view>

        <view class="dish-list">
          <view wx:for="{{visibleItems}}" wx:key="id" class="dish-card">
            <view class="dish-visual" style="background: {{item.tone}}">
              <text class="dish-emoji">{{item.emoji}}</text>
              <text wx:if="{{item.badge}}" class="dish-badge">{{item.badge}}</text>
            </view>
            <view class="dish-info">
              <view class="dish-name">{{item.name}}</view>
              <view class="dish-description">{{item.description}}</view>
              <view class="dish-bottom">
                <view class="dish-price"><text class="currency">¥</text>{{item.priceText}}</view>
                <view class="quantity-control">
                  <button
                    wx:if="{{item.quantity > 0}}"
                    class="quantity-button minus-button"
                    hover-class="button-hover"
                    data-id="{{item.id}}"
                    data-delta="-1"
                    bindtap="changeQuantity"
                  >−</button>
                  <text wx:if="{{item.quantity > 0}}" class="quantity-value">{{item.quantity}}</text>
                  <button
                    class="quantity-button plus-button"
                    hover-class="button-hover"
                    data-id="{{item.id}}"
                    data-delta="1"
                    bindtap="changeQuantity"
                  >+</button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{totalQuantity > 0}}" class="cart-dock">
    <view class="cart-dock-info">
      <view class="cart-bag">
        <text>袋</text>
        <view class="cart-badge">{{totalQuantity}}</view>
      </view>
      <view class="cart-total">
        <view><text class="cart-currency">¥</text>{{subtotalText}}</view>
        <view class="cart-hint">桌号 {{tableNo}}</view>
      </view>
    </view>
    <button class="checkout-button" hover-class="checkout-button-hover" bindtap="openCheckout">
      去结算
    </button>
  </view>
  <view wx:else class="cart-hint-bar">选择喜欢的菜品，加入餐桌</view>
</view>

