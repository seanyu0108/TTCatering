.menu-page {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.store-header {
  padding: 30rpx 32rpx 24rpx;
}

.store-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-status {
  display: flex;
  gap: 10rpx;
  align-items: center;
  color: #667252;
  font-size: 21rpx;
  font-weight: 600;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #78904e;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(120, 144, 78, 0.13);
}

.table-pill {
  padding: 11rpx 20rpx;
  color: #9c4b30;
  font-size: 22rpx;
  font-weight: 650;
  background: #f2ddcc;
  border-radius: 20rpx;
}

.store-name {
  margin-top: 18rpx;
  color: #29251f;
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.store-meta {
  margin-top: 8rpx;
  color: #8d7a6a;
  font-size: 22rpx;
}

.category-scroll {
  position: sticky;
  top: 0;
  z-index: 8;
  width: 100%;
  background: rgba(247, 241, 232, 0.96);
}

.category-row {
  display: flex;
  gap: 14rpx;
  width: max-content;
  padding: 14rpx 32rpx 18rpx;
}

.category-tab {
  padding: 18rpx 28rpx;
  color: #7f6e60;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  background: #fffaf4;
  border: 2rpx solid #ecdfd1;
  border-radius: 22rpx;
}

.category-tab-active {
  color: #fffaf3;
  background: #3b3d31;
  border-color: #3b3d31;
  box-shadow: 0 10rpx 20rpx rgba(59, 61, 49, 0.16);
}

.menu-content {
  padding: 20rpx 32rpx;
}

.category-section {
  animation: rise 180ms ease-out;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.category-title {
  margin-top: 8rpx;
  color: #312b25;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 700;
}

.item-count {
  color: #a28d7c;
  font-size: 21rpx;
}

.category-description {
  margin-top: 8rpx;
  color: #8b7869;
  font-size: 22rpx;
}

.dish-list {
  margin-top: 24rpx;
}

.dish-card {
  display: flex;
  padding: 18rpx;
  margin-bottom: 18rpx;
  background: #fffaf3;
  border: 2rpx solid #efe3d7;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(91, 65, 43, 0.05);
}

.dish-visual {
  position: relative;
  display: flex;
  flex: 0 0 190rpx;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 190rpx;
  overflow: hidden;
  border-radius: 24rpx;
}

.dish-visual::before {
  position: absolute;
  top: -30rpx;
  right: -18rpx;
  width: 96rpx;
  height: 96rpx;
  content: "";
  background: rgba(255, 255, 255, 0.26);
  border-radius: 50%;
}

.dish-emoji {
  position: relative;
  z-index: 1;
  font-size: 82rpx;
  filter: drop-shadow(0 10rpx 12rpx rgba(84, 54, 29, 0.16));
}

.dish-badge {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  padding: 6rpx 12rpx;
  color: #fff8ef;
  font-size: 17rpx;
  font-weight: 650;
  background: rgba(54, 47, 39, 0.72);
  border-radius: 10rpx;
}

.dish-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 8rpx 4rpx 4rpx 22rpx;
}

.dish-name {
  color: #302a25;
  font-size: 30rpx;
  font-weight: 700;
}

.dish-description {
  display: -webkit-box;
  margin-top: 9rpx;
  overflow: hidden;
  color: #948171;
  font-size: 21rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.dish-price {
  color: #c34927;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.currency {
  margin-right: 4rpx;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 21rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
  height: 56rpx;
}

.quantity-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50%;
}

.plus-button {
  color: #fffaf3;
  background: #d95b36;
}

.minus-button {
  color: #a24c31;
  background: #f5e6d9;
}

.quantity-value {
  min-width: 48rpx;
  color: #4b3c31;
  font-size: 24rpx;
  font-weight: 650;
  text-align: center;
}

.cart-dock {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 12rpx 14rpx 12rpx 24rpx;
  background: #312f29;
  border-radius: 34rpx;
  box-shadow: 0 20rpx 44rpx rgba(45, 38, 30, 0.26);
}

.cart-dock-info {
  display: flex;
  flex: 1;
  align-items: center;
}

.cart-bag {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-right: 18rpx;
  color: #3a332b;
  font-family: "Songti SC", "STSong", serif;
  font-size: 23rpx;
  font-weight: 700;
  background: #e6bd7d;
  border-radius: 20rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 7rpx;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 19rpx;
  line-height: 34rpx;
  text-align: center;
  background: #dc5030;
  border: 3rpx solid #312f29;
  border-radius: 18rpx;
}

.cart-total {
  color: #fff8ed;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.cart-currency {
  margin-right: 3rpx;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 20rpx;
}

.cart-hint {
  margin-top: 2rpx;
  color: rgba(255, 248, 237, 0.48);
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 19rpx;
  font-weight: 400;
}

.checkout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 88rpx;
  color: #fff9ef;
  font-size: 27rpx;
  font-weight: 700;
  background: #d95531;
  border-radius: 24rpx;
}

.checkout-button-hover {
  background: #c74625;
}

.cart-hint-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 10;
  height: 82rpx;
  color: rgba(255, 248, 237, 0.54);
  font-size: 22rpx;
  line-height: 82rpx;
  text-align: center;
  background: rgba(49, 47, 41, 0.9);
  border-radius: 26rpx;
}

.button-hover {
  opacity: 0.72;
}

