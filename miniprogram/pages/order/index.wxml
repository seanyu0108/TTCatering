<view wx:if="{{order}}" class="order-page">
  <view class="success-hero">
    <view class="success-mark">
      <view class="check-line check-line-one"></view>
      <view class="check-line check-line-two"></view>
    </view>
    <view class="success-title">{{created ? '下单成功' : '订单详情'}}</view>
    <view class="success-copy">{{created ? '厨房已经开始准备你的餐点' : '感谢你的光临，请慢慢享用'}}</view>
    <view class="pickup-number">{{order.pickupNumber}}</view>
    <view class="pickup-caption">取餐序号</view>
  </view>

  <view class="order-card">
    <view class="order-card-top">
      <view>
        <view class="order-card-label">桌号 {{order.tableNo}}</view>
        <view class="order-type">{{order.orderType}}</view>
      </view>
      <view class="order-status">{{order.status}}</view>
    </view>

    <view class="progress-track">
      <view wx:for="{{order.statusSteps}}" wx:key="label" class="progress-step">
        <view class="progress-dot {{item.done ? 'progress-dot-done' : ''}}"></view>
        <view class="progress-label {{item.done ? 'progress-label-done' : ''}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="detail-card">
    <view class="card-heading">菜品明细</view>
    <view wx:for="{{order.lines}}" wx:key="id" class="order-line">
      <view class="order-line-main">
        <text class="order-line-name">{{item.name}}</text>
        <text class="order-line-quantity">× {{item.quantity}}</text>
      </view>
      <view class="order-line-price">¥{{item.lineTotalText}}</view>
    </view>
    <view wx:if="{{order.remark}}" class="order-remark">备注：{{order.remark}}</view>
    <view class="total-row">
      <text>合计</text>
      <text class="total-price">¥{{order.subtotalText}}</text>
    </view>
  </view>

  <view class="order-meta">
    <view class="meta-row">
      <text>订单编号</text>
      <text>{{order.id}}</text>
    </view>
    <view class="meta-row">
      <text>下单时间</text>
      <text>{{order.createdAtText}}</text>
    </view>
  </view>

  <view class="action-row">
    <button class="secondary-button action-button" bindtap="goOrders">全部订单</button>
    <button class="primary-button action-button" bindtap="goMenu">继续加菜</button>
  </view>
</view>

<view wx:else class="empty-state">
  <view class="missing-title">没有找到这笔订单</view>
  <view class="missing-copy">订单可能已经被清理，请返回菜单重新点餐。</view>
</view>

