.checkout-page {
  min-height: 100vh;
  padding: 26rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
}

.checkout-heading {
  padding: 12rpx 4rpx 28rpx;
}

.checkout-title {
  margin-top: 10rpx;
  color: #2d2823;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 700;
}

.checkout-subtitle {
  margin-top: 9rpx;
  color: #8d7a6a;
  font-size: 22rpx;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel {
  padding: 26rpx;
  background: #fffaf3;
  border: 2rpx solid #eee1d4;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(91, 65, 43, 0.04);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.panel-title {
  color: #3d332b;
  font-size: 28rpx;
  font-weight: 700;
}

.panel-caption {
  color: #a28d7c;
  font-size: 20rpx;
}

.order-type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.order-type-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 152rpx;
  padding: 20rpx 22rpx;
  color: #57483c;
  text-align: left;
  background: #f7f1e9;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
}

.order-type-active {
  color: #9f472d;
  background: #f8e7d8;
  border-color: #d65b36;
}

.order-type-icon {
  font-size: 32rpx;
}

.order-type-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.order-type-note {
  margin-top: 4rpx;
  color: #9d8877;
  font-size: 19rpx;
}

.checkout-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0e6dc;
}

.checkout-line:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.line-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  margin-right: 18rpx;
  font-size: 42rpx;
  border-radius: 20rpx;
}

.line-copy {
  flex: 1;
  min-width: 0;
}

.line-name {
  overflow: hidden;
  color: #40372f;
  font-size: 25rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-meta {
  margin-top: 8rpx;
  color: #9a8777;
  font-size: 20rpx;
}

.line-total {
  margin-left: 18rpx;
  color: #473b31;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26rpx;
  font-weight: 700;
}

.remark-panel {
  padding-bottom: 20rpx;
}

.remark-input {
  width: 100%;
  min-height: 94rpx;
  padding: 20rpx;
  color: #44382f;
  font-size: 24rpx;
  line-height: 1.6;
  background: #f7f1e9;
  border-radius: 20rpx;
}

.remark-placeholder {
  color: #b8a391;
}

.summary-panel {
  padding: 12rpx 8rpx 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 4rpx;
  color: #7e6d60;
  font-size: 24rpx;
}

.summary-total {
  align-items: baseline;
  margin-top: 8rpx;
  padding-top: 22rpx;
  color: #312a24;
  font-size: 30rpx;
  font-weight: 700;
  border-top: 1rpx solid #e5d8ca;
  font-family: Georgia, "Times New Roman", serif;
}

.summary-currency {
  margin-right: 4rpx;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 20rpx;
}

.summary-note {
  padding: 8rpx 4rpx 0;
  color: #ac9a8b;
  font-size: 19rpx;
}

.empty-title {
  color: #4b3e34;
  font-size: 32rpx;
  font-weight: 650;
}

.empty-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
}

.checkout-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 243, 0.97);
  border-top: 1rpx solid #e8dacd;
  box-shadow: 0 -6rpx 24rpx rgba(70, 49, 31, 0.06);
}

.footer-total {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.footer-label {
  color: #988475;
  font-size: 20rpx;
}

.footer-price {
  margin-top: 2rpx;
  color: #c34b29;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 700;
}

.footer-currency {
  margin-right: 3rpx;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 21rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 330rpx;
  height: 96rpx;
  color: #fff9ef;
  font-size: 28rpx;
  font-weight: 700;
  background: #d95732;
  border-radius: 27rpx;
}

.submit-button[disabled] {
  color: rgba(255, 249, 239, 0.72);
  background: #c8a89a;
}

